{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "ANAKIN_API_KEY",
    "SARVAM_API_KEY",
    "PORT",
    "CLIENT_URL",
    "NODE_ENV"
  ],
  "tasks": {
    "dev": {
